{
  "schema_version": 1,
  "datasets": {
    "waymo": {
      "name": "Waymo Open Dataset Perception",
      "homepage": "https://waymo.com/open/download/",
      "license_url": "https://waymo.com/open/terms/",
      "loader": "datasets.waymo_processed_dataset.WaymoPi3XDataset",
      "verify": [
        {"glob": "*/images/*.*", "min_count": 8},
        {"glob": "*/lidars/*.npy", "min_count": 8},
        {"glob": "*/intrinsics/*.txt", "min_count": 8},
        {"glob": "*/extrinsics/*.txt", "min_count": 8},
        {"glob": "*/ego_pose/*.txt", "min_count": 8}
      ],
      "profiles": {
        "minimal": {
          "mode": "authorized-input",
          "description": "Convert one official Perception TFRecord and retain up to 80 frames for loader and geometry tests.",
          "download_bytes": 200000000,
          "disk_bytes": 800000000,
          "default_output": "data/waymo_processed",
          "license_accept_required": true,
          "prerequisites": ["Sign in on the Waymo download page and download one Perception v1 TFRecord.", "Pass the TFRecord path through --input."],
          "recipe": {"type": "waymo", "one_record": true, "max_frames": 80},
          "next_command": "python -m datasets.tools verify waymo"
        },
        "train": {
          "mode": "authorized-input",
          "description": "Convert every official Perception TFRecord in an authorized local directory.",
          "download_bytes": 1100000000000,
          "disk_bytes": 4000000000000,
          "default_output": "data/waymo_processed_train",
          "license_accept_required": true,
          "prerequisites": ["Download the required Waymo training shards after accepting the Waymo license.", "Pass the directory containing TFRecords through --input."],
          "recipe": {"type": "waymo"},
          "next_command": "python -m datasets.tools verify waymo --profile train"
        }
      }
    },
