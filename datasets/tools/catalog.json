      "loader": "datasets.arkit_dataset.ARKitScenesPi3XDataset",
      "verify": [
        {"glob": "**/lowres_wide/*.png", "min_count": 8},
        {"glob": "**/lowres_depth/*.png", "min_count": 8},
        {"glob": "**/lowres_wide_intrinsics/*.pincam", "min_count": 8},
        {"glob": "**/lowres_wide.traj", "min_count": 1}
      ],
      "profiles": {
        "minimal": {
          "mode": "official-tool",
          "description": "Download raw video 41069021 with only the four assets consumed by the loader.",
          "download_bytes": 200000000,
          "disk_bytes": 500000000,
          "default_output": "data/arkitscenes_minimal/raw",
          "prerequisites": ["Git must be available. The command uses Apple's official download_data.py."],
          "recipe": {
            "type": "official-command",
            "commands": [
              ["git", "clone", "https://github.com/apple/ARKitScenes.git", "{cache}/ARKitScenes"],
              ["{python}", "{cache}/ARKitScenes/download_data.py", "raw", "--split", "Validation", "--video_id", "41069021", "--download_dir", "{output}", "--raw_dataset_assets", "lowres_depth", "lowres_wide.traj", "lowres_wide", "lowres_wide_intrinsics"]
            ]
          },
          "next_command": "python -m datasets.tools verify arkitscenes"
        },
        "train": {
          "mode": "official-tool",
          "description": "Download every ARKitScenes raw training and validation capture with loader-required assets.",
          "download_bytes": 700000000000,
          "disk_bytes": 1200000000000,
          "default_output": "data/arkitscenes/raw",
          "prerequisites": ["Git must be available. Review Apple's license before starting the full download."],
          "recipe": {
            "type": "official-command",
            "commands": [
              ["git", "clone", "https://github.com/apple/ARKitScenes.git", "{cache}/ARKitScenes"],
              ["{python}", "{cache}/ARKitScenes/download_data.py", "raw", "--video_id_csv", "{cache}/ARKitScenes/raw/raw_train_val_splits.csv", "--download_dir", "{output}", "--raw_dataset_assets", "lowres_depth", "lowres_wide.traj", "lowres_wide", "lowres_wide_intrinsics"]
            ]
